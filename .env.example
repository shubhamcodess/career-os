# Career OS — Environment Variables Template
# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real tokens.

# ── GitHub ──
# Required for: GitHub MCP (repo operations), github-market-map skill, profile-intelligence GitHub lookup
# Create at: https://github.com/settings/tokens (classic token, scopes: repo, read:user)
GITHUB_PERSONAL_ACCESS_TOKEN=

# ── Firecrawl ──
# Used for: fetching full JD pages, company profiling, candidate profile research
# Use sparingly — only for high-value scraping tasks, not routine searches
# Get key at: https://www.firecrawl.dev
FIRECRAWL_API_KEY=

# ── Naukri Scraper (optional, no key needed) ──
# No API key required — uses Playwright browser automation
# Set naukri_enabled in config/user.json to activate

# ── Note ──
# Every key above is free to obtain. No paid API keys are required for this setup.
# A LinkedIn-layer data source (e.g. Crustdata) would add richer people-search
# capability to profile-intelligence, but it requires a paid plan and is intentionally
# left out for now. See skills/profile-intelligence/SKILL.md "Future Upgrade" section
# if you want to add one later.
