# Career OS — Environment Variables Template
# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real tokens.

# ── Personalize ──────────────────────────────────────────────────────────────
# Set to true if you are using Career OS for your own job search.
# When true: Claude runs the full career OS experience — intake interview,
#   resume pipeline, job search, and personal data backup to your private repo.
# When false (default): framework/contributor mode — Claude helps improve the
#   Career OS framework itself; it does not try to load or save personal data.
PERSONALIZE=false

# ── Private Vault Repo ────────────────────────────────────────────────────────
# Your private GitHub repo that stores personal data (resumes, interview notes, etc.)
# Create a new private repo on GitHub, then paste the SSH clone URL here.
# Example: git@github.com:yourusername/career-os-private.git
# Used by: bash scripts/sync-vault.sh  (the "backup" command)
PRIVATE_REPO_URL=

# ── GitHub ────────────────────────────────────────────────────────────────────
# Required for: GitHub MCP (repo operations), github-market-map skill, profile-intelligence
# Create at: https://github.com/settings/tokens (classic token, scopes: repo, read:user)
GITHUB_PERSONAL_ACCESS_TOKEN=

# ── Web research ───────────────────────────────────────────────────────────────
# No key required. Claude's built-in WebSearch and WebFetch are the web layer for
# this project — JD fetching, company intel, careers pages, recruiter research.
# Firecrawl was removed: it added a paid dependency and a second failure mode for
# no capability Career OS needed.

# ── Naukri Scraper (optional, no key needed) ──────────────────────────────────
# No API key required — uses Playwright + system Chrome
# Set naukri_enabled in config/user.json to activate
# Requires: pip3 install playwright playwright-stealth && python3 -m playwright install chromium
# System Chrome (/Applications/Google Chrome.app) must also be installed

# ── Note ──────────────────────────────────────────────────────────────────────
# Every key above is free to obtain. No paid API keys are required for this setup.
# A LinkedIn-layer data source (e.g. Crustdata) would add richer people-search
# capability to profile-intelligence, but it requires a paid plan and is intentionally
# excluded. See skills/profile-intelligence/SKILL.md "Future Upgrade" section.
