# ── Secrets — never commit ──
.env
config/user.json

# ── Local-only Claude instructions (personal git config, private remotes) ──
.claude/CLAUDE.md

# ── Personal data — gitignored by default in the public template ──
# If you fork this to build your own private career OS, either:
#   (a) keep your fork private, or
#   (b) remove these lines to track your own data in your own private repo
# Everything under data/ is personal. Ignore it all, so a new data folder can never
# leak by being forgotten here. Only the empty-folder placeholder is tracked.
data/*
!data/outreach/
data/outreach/*
!data/outreach/.gitkeep
checkpoints/interview-state.md
resumes/*/
!resumes/.gitkeep
exports/*.json
!exports/.gitkeep

# ── Dependencies ──
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# ── Puppeteer / Playwright cache ──
.local-chromium/
.playwright-cache/

# ── OS files ──
.DS_Store
Thumbs.db

# ── Temp files ──
*.tmp
*.temp
.personal-worktree/

# ── Resolved ATS registry (personal target list) ──
config/companies.json
config/agencies.json
